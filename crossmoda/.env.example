# ============================================
# RayMatrix AI API 配置文件模板
# ============================================
# 
# 使用方法：复制此文件并重命名为 .env，然后填入您的真实密钥
# 命令：copy .env.example .env
#
# ============================================

# ----- 文本AI服务密钥 -----
# 获取方式：
#   方案A（推荐）: 阿里云百炼 - 访问 https://bailian.console.aliyun.com 注册获取
#   方案B: DeepSeek - 访问 https://platform.deepseek.com 注册获取
#   方案C: OpenAI - 访问 https://platform.openai.com 注册获取
#   方案D: 其他兼容OpenAI格式的服务（如硅基流动、智谱等）
#
# 把下面替换成您的真实密钥
VITE_AI_API_KEY=your-api-key-here

# ----- 文本AI服务网址 -----
# 阿里云百炼(推荐，和图片视频共用同一把钥匙): https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com/v1
# 硅基流动: https://api.siliconflow.cn/v1
VITE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ----- 使用的AI模型名称 -----
# 阿里云百炼: qwen-plus (推荐，性价比高)
# DeepSeek: deepseek-chat
# OpenAI: gpt-4o-mini (便宜) 或 gpt-4o (更强)
# 硅基流动: Qwen/Qwen2.5-7B-Instruct (免费额度)
VITE_AI_MODEL=qwen-plus

# ============================================
# 阿里云百炼 DashScope API 配置
# ============================================
# 支持万相(Wan)图像生成、HappyHorse视频生成
# API Key 与上方文本AI可共用同一个阿里云百炼Key
#
# 获取方式：访问 https://bailian.console.aliyun.com 注册获取
# ============================================

# ----- DashScope API密钥 -----
VITE_DASHSCOPE_API_KEY=your-dashscope-key-here

# ----- DashScope 基础URL（华北2-北京） -----
# 北京: https://dashscope.aliyuncs.com
# 新加坡: https://dashscope-intl.aliyuncs.com
# 弗吉尼亚: https://dashscope-us.aliyuncs.com
VITE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ----- 图像生成模型 -----
# wan2.7-image-pro: 专业版，文生图支持4K
# wan2.7-image: 标准版，速度更快
VITE_DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro

# ----- 视频生成模型 -----
# happyhorse-1.0-t2v: 文生视频
# happyhorse-1.0-i2v: 图生视频
VITE_DASHSCOPE_VIDEO_T2V_MODEL=happyhorse-1.0-t2v
VITE_DASHSCOPE_VIDEO_I2V_MODEL=happyhorse-1.0-i2v
